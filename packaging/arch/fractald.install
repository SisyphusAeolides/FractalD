post_install() {
    if ! /usr/bin/fractald-package-trigger sync; then
        printf '%s\n' 'FractalD package service scan will retry on the next transaction.' >&2
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    if [[ -x /usr/bin/fractald-package-trigger ]]; then
        /usr/bin/fractald-package-trigger sync || true
    fi
}
