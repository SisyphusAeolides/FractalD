#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	cargo build --release --workspace --offline
	mkdir -p target/release
	$(CC) $(CFLAGS) $(CPPFLAGS) $(LDFLAGS) -std=c11 -O2 -Wall -Wextra -Werror -fPIC -shared -Wl,-soname,libnss_fractald.so.2 -o target/release/libnss_fractald.so.2 crates/fractald-nss/fractald_nss.c -lresolv

override_dh_update_autotools_config:
	:

override_dh_autoreconf:
	:

override_dh_auto_configure:
	:

override_dh_auto_test:
	cargo test --workspace --offline -- --test-threads=1

override_dh_auto_install:
	$(MAKE) install PREFIX=/usr BINDIR=/usr/bin NSSLIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) DATADIR=/usr/share SYSCONFDIR=/etc SYSTEMDUNITDIR=/usr/lib/systemd/system DESTDIR=$(CURDIR)/debian/fractald

override_dh_auto_clean:
	:

override_dh_clean:
	set -eu; for path in debian/.debhelper debian/fractald debian/tmp; do if [ -e "$$path" ]; then rm -r "$$path"; fi; done; for path in debian/debhelper-build-stamp debian/fractald.substvars debian/files; do if [ -e "$$path" ]; then rm "$$path"; fi; done
